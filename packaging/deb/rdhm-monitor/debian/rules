#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		-DBUILD_AGENT=OFF \
		-DBUILD_MONITOR=ON \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCppRestAPI_BuildShared=OFF

override_dh_auto_build:
	dh_auto_build -- monitor

override_dh_auto_test:
	# Tests require build infrastructure not available during packaging
	:
